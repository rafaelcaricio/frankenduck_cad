{
  "code": "# foot_left_native_b: Frankenduck walking foot, piece b of 2 (top plate).\n# Native rebuild of mesh foot_<side>, robot world frame, mm, Z up. Both pieces sit at the origin; together (union) they\n# reproduce the foot. The foot is split at the sole top plane Z = split_z only to stay under the original geometry budget:\n#   piece a = rocker body below split_z (outer walls, ribs, cradle seat) plus the two clip tab roots above it,\n#   piece b = top plate above split_z (rails, X-end quarter rounds, drafted Y faces).\n# Left = +Y, right = -Y (exact mirror about Y = 0); the profile data is the left foot.\nimport math\nimport cadquery as cq\nfrom source_api import Model\n\nSIDE = 1  # side switch: 1 = left (+Y), -1 = right (-Y)\n\nsplit_z = -12.3857  # mm Piece split plane (sole top / foot plate underside)\naxis_x = -42.899  # mm Ankle bearing axis X (cradle bed axis, along Y)\naxis_z = 3.975  # mm Ankle bearing axis Z\nshoulder_r = 21.99  # mm Cradle shoulder radius about the bearing axis\nshoulder_y0 = 44.145  # mm Cradle pocket start Y (vertical end wall)\nshoulder_y1 = 90.315  # mm Cradle pocket end Y (vertical end wall)\nbed_r = 22.13  # mm Cradle bed radius (mesh is faceted between 21.98 and 22.27)\nbed_y0 = 45.78  # mm Cradle bed start Y\nbed_y1 = 88.68  # mm Cradle bed end Y\nplate_x0 = -69.899  # mm Top plate -X end\nplate_x1 = 3.001  # mm Top plate +X end\nplate_round_r = 6.75  # mm Quarter round on both X ends of the top plate (XZ)\ntab_x0_a = -65.5  # mm Clip tab window -X tab start X (tab roots go to piece a)\ntab_x0_b = -15.2  # mm Clip tab window +X tab start X\ntab_dx = 4.0  # mm Clip tab window X size\ntab_y0 = 60.43  # mm Clip tab window start Y\ntab_y1 = 74.03  # mm Clip tab window end Y\ntab_h = 8.2  # mm Clip tab window height above split_z\ndraft_lo = ((40.339, -12.386), (40.722, -9.011))  # mm -Y face draft line (Y, Z) bottom -> top\ndraft_hi = ((94.455, -12.386), (94.032, -9.011))  # mm +Y face draft line (Y, Z) bottom -> top\n\n\ndef _p3(axis, lvl, u, v):\n    # profile coordinates are the two remaining world axes in X, Y, Z order\n    return cq.Vector(*((lvl, u, v) if axis == 0 else (u, lvl, v) if axis == 1 else (u, v, lvl)))\n\n\ndef _edges(ring, at):\n    start, segs = ring\n    cur = at(*start)\n    edges = []\n    for s in segs:\n        nxt = at(*s[-1])\n        if s[0] == \"A\" and ((at(*s[1]) - cur).cross(nxt - cur)).Length > 1e-4:\n            edges.append(cq.Edge.makeThreePointArc(cur, at(*s[1]), nxt))\n        elif (nxt - cur).Length > 1e-6:\n            edges.append(cq.Edge.makeLine(cur, nxt))\n        cur = nxt\n    return cq.Wire.assembleEdges(edges)\n\n\ndef _face(axis, lvl, outer, holes=()):\n    f = cq.Face.makeFromWires(_edges(outer, lambda u, v: _p3(axis, lvl, u, v)),\n                              [_edges(h, lambda u, v: _p3(axis, lvl, u, v)) for h in holes])\n    return f if f.isValid() else f.fix()\n\n\ndef slab_stack(axis, slabs):\n    \"\"\"Stacked extrusions along one world axis: [[lo, hi, [[outer_ring, [hole_rings]], ...]], ...].\n    A ring is [start, segments]; a segment is [\"L\", end] or [\"A\", through, end].\"\"\"\n    out = None\n    for lo, hi, faces in slabs:\n        d = [0, 0, 0]\n        d[axis] = hi - lo\n        for outer, holes in faces:\n            s = cq.Solid.extrudeLinear(_face(axis, lo, outer, holes), cq.Vector(*d))\n            out = s if out is None else out.fuse(s)\n    return out.clean()\n\n\ndef side(shape):\n    # the profile data is the left foot; the right foot is its exact mirror about Y = 0\n    return shape.mirror(\"XZ\") if SIDE < 0 else shape\n\n\ndef cradle_cut():\n    shoulder = cq.Solid.makeCylinder(shoulder_r, shoulder_y1 - shoulder_y0, cq.Vector(axis_x, shoulder_y0, axis_z), cq.Vector(0, 1, 0))\n    bed = cq.Solid.makeCylinder(bed_r, bed_y1 - bed_y0, cq.Vector(axis_x, bed_y0, axis_z), cq.Vector(0, 1, 0))\n    return shoulder.fuse(bed)\n\n\ndef top_envelope():\n    # Y prism of the top plate XZ outline: quarter rounds of plate_round_r on both X ends\n    c = math.sqrt(0.5) * plate_round_r\n    xa, xb = plate_x0 + plate_round_r, plate_x1 - plate_round_r\n    return (cq.Workplane(\"XZ\").moveTo(plate_x0, split_z - 1).lineTo(plate_x1, split_z - 1).lineTo(plate_x1, split_z)\n            .threePointArc((xb + c, split_z + c), (xb, split_z + plate_round_r)).lineTo(xb, split_z + 20)\n            .lineTo(xa, split_z + 20).lineTo(xa, split_z + plate_round_r)\n            .threePointArc((xa - c, split_z + c), (plate_x0, split_z)).close().extrude(-200, both=True).val())\n\n\ndef tab_boxes():\n    # windows start 1 mm below split_z so the cut leaves no slivers on the split plane\n    return cq.Solid.makeBox(tab_dx, tab_y1 - tab_y0, tab_h + 1, cq.Vector(tab_x0_a, tab_y0, split_z - 1)).fuse(\n        cq.Solid.makeBox(tab_dx, tab_y1 - tab_y0, tab_h + 1, cq.Vector(tab_x0_b, tab_y0, split_z - 1)))\n\n\ndef upper_body():\n    return slab_stack(2, TOP_SLABS).intersect(top_envelope())\n\n\ndef side_drafts():\n    out = None\n    for (y0, z0), (y1, z1), k in ((*draft_lo, -1), (*draft_hi, 1)):\n        w = cq.Workplane(\"YZ\").polyline([(y0, z0), (y1, z1), (y1 + 5 * k, z1), (y0 + 5 * k, z0)]).close().extrude(100, both=True).val()\n        out = w if out is None else out.fuse(w)\n    return out\n\n\n# fmt: off\nTOP_SLABS = [\n    [-12.386, -9.686, [\n        [[[-5.664,94.419],[[\"A\",[0.535,91.344],[3.001,84.666]],[\"A\",[2.975,49.149],[2.884,48.363]],[\"A\",[-0.019,42.883],[-6.781,40.341]],[\"L\",[-63.092,40.367]],[\"A\",[-67.962,42.781],[-69.899,48.22]],[\"L\",[-69.879,87.523]],[\"A\",[-67.527,92.452],[-62.182,94.452]],[\"L\",[-6.449,94.452]],[\"L\",[-5.664,94.419]]]],\n         [[[-5.488,78.705],[[\"L\",[-6.669,78.705]],[\"L\",[-6.669,55.755]],[\"L\",[-5.488,55.755]],[\"L\",[-5.488,45.91]],[\"A\",[-3.776,47.166],[-3.209,48.988]],[\"L\",[-3.21,85.514]],[\"A\",[-4.071,87.661],[-5.488,88.549]],[\"L\",[-5.488,78.705]]]],[[-7.851,88.695],[[\"L\",[-10.044,88.695]],[\"L\",[-10.044,78.705]],[\"L\",[-7.851,78.705]],[\"L\",[-7.851,88.695]]]],[[-7.851,55.755],[[\"L\",[-10.044,55.755]],[\"L\",[-10.044,45.765]],[\"L\",[-7.851,45.765]],[\"L\",[-7.851,55.755]]]],[[-10.045,75.33],[[\"L\",[-14.634,75.33]],[\"L\",[-14.634,59.13]],[\"L\",[-10.044,59.13]],[\"L\",[-10.045,75.33]]]],[[-18.197,67.23],[[\"A\",[-19.277,68.31],[-20.357,67.23]],[\"A\",[-19.277,66.15],[-18.197,67.23]]]],[[-57.608,88.83],[[\"L\",[-61.479,88.83]],[\"L\",[-61.479,81.81]],[\"L\",[-57.608,81.81]],[\"L\",[-57.608,52.65]],[\"L\",[-61.479,52.65]],[\"L\",[-61.479,45.63]],[\"L\",[-57.608,45.63]],[\"L\",[-57.607,44.145]],[\"L\",[-28.19,44.145]],[\"L\",[-28.191,90.315]],[\"L\",[-57.608,90.315]],[\"L\",[-57.608,88.83]]]],[[-61.48,75.33],[[\"L\",[-66.069,75.33]],[\"L\",[-66.069,59.13]],[\"L\",[-61.479,59.13]],[\"L\",[-61.48,75.33]]]]]],\n        [[[-11.712,73.98],[[\"L\",[-11.712,60.48]],[\"L\",[-13.284,60.48]],[\"L\",[-13.284,73.98]],[\"L\",[-11.712,73.98]]]],\n         []],\n        [[[-62.829,73.98],[[\"L\",[-62.829,60.48]],[\"L\",[-64.402,60.48]],[\"L\",[-64.402,73.98]],[\"L\",[-62.829,73.98]]]],\n         []],\n    ]],\n    [-9.686, -9.013, [\n        [[[-69.324,89.512],[[\"A\",[-66.717,92.769],[-62.474,94.114]],[\"L\",[-5.98,94.095]],[\"A\",[-0.598,92.07],[2.426,87.855]],[\"L\",[2.403,46.829]],[\"A\",[-0.615,42.677],[-6.449,40.648]],[\"L\",[-63.114,40.676]],[\"A\",[-66.786,42.043],[-69.325,45.243]],[\"L\",[-69.324,89.512]]]],\n         [[[-5.488,78.705],[[\"L\",[-6.669,78.705]],[\"L\",[-6.669,55.755]],[\"L\",[-5.488,55.755]],[\"L\",[-5.488,45.91]],[\"A\",[-3.754,47.199],[-3.209,48.988]],[\"L\",[-3.209,85.472]],[\"A\",[-4.072,87.662],[-5.488,88.549]],[\"L\",[-5.488,78.705]]]],[[-7.851,88.695],[[\"L\",[-10.044,88.695]],[\"L\",[-10.044,78.705]],[\"L\",[-7.851,78.705]],[\"L\",[-7.851,88.695]]]],[[-7.851,55.755],[[\"L\",[-10.044,55.755]],[\"L\",[-10.03,45.765]],[\"L\",[-7.851,45.765]],[\"L\",[-7.851,55.755]]]],[[-10.045,75.33],[[\"L\",[-14.634,75.33]],[\"L\",[-14.634,59.13]],[\"L\",[-10.044,59.13]],[\"L\",[-10.045,75.33]]]],[[-17.252,67.23],[[\"A\",[-19.277,69.255],[-21.302,67.23]],[\"A\",[-19.277,65.205],[-17.252,67.23]]]],[[-60.141,81.81],[[\"L\",[-60.141,52.65]],[\"L\",[-61.479,52.65]],[\"L\",[-61.479,45.63]],[\"L\",[-60.141,45.63]],[\"L\",[-60.12,44.145]],[\"L\",[-31.042,44.145]],[\"A\",[-31.042,42.675],[-26.756,42.675]],[\"L\",[-26.756,44.145]],[\"L\",[-25.657,44.145]],[\"L\",[-25.658,90.315]],[\"L\",[-60.141,90.315]],[\"L\",[-60.141,88.83]],[\"L\",[-61.479,88.815]],[\"L\",[-61.479,81.81]],[\"L\",[-60.141,81.81]]]],[[-61.48,75.33],[[\"L\",[-66.069,75.33]],[\"L\",[-66.069,59.13]],[\"L\",[-61.479,59.13]],[\"L\",[-61.48,75.33]]]]]],\n        [[[-12.012,73.98],[[\"L\",[-12.012,60.48]],[\"L\",[-13.284,60.48]],[\"L\",[-13.284,73.98]],[\"L\",[-12.012,73.98]]]],\n         []],\n        [[[-62.829,73.98],[[\"L\",[-62.829,60.48]],[\"L\",[-64.102,60.48]],[\"L\",[-64.102,73.98]],[\"L\",[-62.829,73.98]]]],\n         []],\n    ]],\n    [-9.013, -6.986, [\n        [[[-13.284,59.13],[[\"L\",[-10.044,59.13]],[\"L\",[-10.045,75.33]],[\"L\",[-13.284,75.33]],[\"L\",[-13.284,93.957]],[\"L\",[-5.664,93.924]],[\"A\",[-1.147,92.316],[1.699,89.252]],[\"L\",[1.7,45.489]],[\"A\",[-1.37,42.282],[-6.449,40.791]],[\"L\",[-13.284,40.791]],[\"L\",[-13.284,59.13]]]],\n         []],\n        [[[-12.152,73.98],[[\"L\",[-12.152,60.48]],[\"L\",[-13.284,60.48]],[\"L\",[-13.284,73.98]],[\"L\",[-12.152,73.98]]]],\n         []],\n        [[[-62.829,93.948],[[\"L\",[-62.829,75.33]],[\"L\",[-66.069,75.33]],[\"L\",[-66.069,59.13]],[\"L\",[-62.829,59.13]],[\"L\",[-62.829,40.799]],[\"A\",[-65.835,41.607],[-68.597,44.041]],[\"L\",[-68.578,90.734]],[\"A\",[-66.028,93.044],[-62.829,93.948]]]],\n         []],\n        [[[-62.829,73.98],[[\"L\",[-62.829,60.48]],[\"L\",[-63.962,60.48]],[\"L\",[-63.962,73.98]],[\"L\",[-62.829,73.98]]]],\n         []],\n    ]],\n    [-6.986, -5.636, [\n        [[[-13.284,75.33],[[\"L\",[-13.284,93.754]],[\"L\",[-5.664,93.721]],[\"A\",[-2.023,92.641],[0.015,91.177]],[\"L\",[0.015,43.549]],[\"A\",[-2.159,42.014],[-6.449,40.975]],[\"L\",[-13.284,40.975]],[\"L\",[-13.284,59.13]],[\"L\",[-10.044,59.13]],[\"L\",[-10.045,75.33]],[\"L\",[-13.284,75.33]]]],\n         []],\n        [[[-12.332,73.98],[[\"L\",[-12.332,60.48]],[\"L\",[-14.634,60.48]],[\"L\",[-14.634,73.98]],[\"L\",[-12.332,73.98]]]],\n         []],\n        [[[-61.479,73.98],[[\"L\",[-61.479,60.48]],[\"L\",[-63.782,60.48]],[\"L\",[-63.782,73.98]],[\"L\",[-61.479,73.98]]]],\n         []],\n        [[[-62.829,93.745],[[\"L\",[-62.829,75.33]],[\"L\",[-66.069,75.33]],[\"L\",[-66.069,59.13]],[\"L\",[-62.829,59.13]],[\"L\",[-62.829,40.983]],[\"A\",[-64.897,41.384],[-66.91,42.458]],[\"L\",[-66.886,92.289]],[\"A\",[-64.899,93.343],[-62.829,93.745]]]],\n         []],\n    ]],\n    [-5.636, -4.286, [\n        [[[-12.534,73.98],[[\"L\",[-12.534,60.48]],[\"L\",[-14.162,60.48]],[\"L\",[-14.162,73.98]],[\"L\",[-12.534,73.98]]]],\n         []],\n        [[[-61.952,73.98],[[\"L\",[-61.952,60.48]],[\"L\",[-63.579,60.48]],[\"L\",[-63.579,73.98]],[\"L\",[-61.952,73.98]]]],\n         []],\n    ]],\n]\n# fmt: on\n\n\nmodel = Model()\nmodel.add(\"top_plate\", side(upper_body().cut(tab_boxes())))\nmodel.add(\"cradle_bed\", side(cradle_cut()), op=\"cut\")\nmodel.add(\"side_drafts\", side(side_drafts()), op=\"cut\")\n\n# Rigid print: provisional PLA library properties; existing local profile uses Bambu PLA Matte.\nmodel.material(\"pla\", color=\"#f96c0a\")\nresult = model.result()\n",
